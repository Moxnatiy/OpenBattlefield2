# Speex 1.2.1 (Xiph.Org, BSD 3-clause: COPYING in the archive), the narrowband
# codec the game's voice chat speaks (net/retail_voice.h,
# docs/functions/voice-transport.md). Fetched at configure time, as SDL3 is, and
# built from the encoder and decoder sources only: no resampler, no preprocessor,
# no Ogg container, nothing the voice path does not call.
include(FetchContent)
FetchContent_Declare(obf2_speex_source
  URL https://downloads.xiph.org/releases/speex/speex-1.2.1.tar.gz
  URL_HASH SHA256=4b44d4f2b38a370a2d98a78329fefc56a0cf93d1c1be70029217baae6628feea
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
)
FetchContent_MakeAvailable(obf2_speex_source)

set(speex_sources
  bits.c cb_search.c exc_10_16_table.c exc_10_32_table.c exc_20_32_table.c
  exc_5_256_table.c exc_5_64_table.c exc_8_128_table.c filters.c gain_table.c
  gain_table_lbr.c hexc_table.c hexc_10_32_table.c high_lsp_tables.c
  lpc.c lsp.c lsp_tables_nb.c ltp.c modes.c modes_wb.c nb_celp.c quant_lsp.c
  sb_celp.c speex.c speex_callbacks.c speex_header.c stereo.c vbr.c vq.c window.c
)
list(TRANSFORM speex_sources PREPEND "${obf2_speex_source_SOURCE_DIR}/libspeex/")
# speex_config_types.h is generated by Speex's own configure; these are the
# values it writes for a platform with <stdint.h>.
set(SIZE16 int16_t)
set(USIZE16 uint16_t)
set(SIZE32 int32_t)
set(USIZE32 uint32_t)
set(INCLUDE_STDINT "#include <stdint.h>")
set(speex_generated "${CMAKE_CURRENT_BINARY_DIR}/speex-include")
configure_file("${obf2_speex_source_SOURCE_DIR}/include/speex/speex_config_types.h.in"
               "${speex_generated}/speex_config_types.h" @ONLY)
add_library(obf2_speex STATIC ${speex_sources})
# The floating-point build: the game's encoder takes its samples as floats
# (net/src/retail_voice_codec.cpp).
target_compile_definitions(obf2_speex PRIVATE FLOATING_POINT USE_ALLOCA EXPORT=)
target_include_directories(obf2_speex SYSTEM PUBLIC
  "${obf2_speex_source_SOURCE_DIR}/include" "${speex_generated}")
# A fetched library is not ours to fix; its warnings are not ours to fail on.
if(MSVC)
  target_compile_options(obf2_speex PRIVATE /W0)
else()
  target_compile_options(obf2_speex PRIVATE -w)
  if(NOT WIN32)
    target_link_libraries(obf2_speex PUBLIC m)
  endif()
endif()
