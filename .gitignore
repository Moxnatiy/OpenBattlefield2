# The original game files — these never go into git
Game Files/
game/
extract/

# Ghidra
ghidra_projects/
*.gpr
*.rep

# Python
.venv/
__pycache__/

# Build output. 167 files and 103 MB of object files in git is noise in
# every `git status` and every diff. The directory stays on disk, it is
# just no longer tracked.
build/

# Archives / macOS
*.arc
.DS_Store

# Third-party work kept for comparison. Deliberately not in git: the
# licences differ (GPL-3.0, and in places none at all) while our tree is
# MIT. It is a source of **hints**, not of code: everything taken from
# there is first verified against the original binary or the game's data.
reference/

# Rust build output (`src/flash`). Same reason as `build/`: hundreds of
# megabytes of artefacts that are rebuilt from source anyway.
target/

# The Ghidra MCP server's configuration. It is nothing but absolute paths
# to one machine's checkout, Ghidra and JDK, so it is useless to anyone
# else and would publish the author's home directory. Copy
# `.mcp.json.example` and fill in your own.
.mcp.json
