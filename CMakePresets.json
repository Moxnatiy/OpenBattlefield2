{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "displayName": "macOS arm64 (Apple Silicon)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "macos-arm64",
      "displayName": "macOS arm64 (Debug)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OBF2_WERROR": "ON" }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "displayName": "Windows x64 (MSVC)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64",
      "displayName": "Windows x64 (Debug)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OBF2_WERROR": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" }
  ],
  "testPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } }
  ]
}
