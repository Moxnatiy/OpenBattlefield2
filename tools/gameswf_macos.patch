index cffe6ac..2ca6f40 100644
--- a/tu-testbed/base/container.h
+++ b/tu-testbed/base/container.h
@@ -805,7 +805,7 @@ public:
 		assert(m_table);
 		m_table->m_entry_count++;
 
-		unsigned int	hash_value = (unsigned int) compute_hash(key);
+		size_t	hash_value = compute_hash(key);	// [openbf2] was truncated to 32 bits
 		int	index = hash_value & m_table->m_size_mask;
 
 		entry*	natural_entry = &(E(index));
@@ -998,7 +998,11 @@ public:
 			: m_next_in_chain(e.m_next_in_chain), m_hash_value(e.m_hash_value), first(e.first), second(e.second)
 		{
 		}
-		entry(const T& key, const U& value, int next_in_chain, int hash_value)
+		// [openbf2] the hash here was an `int`: a 32-bit value with the top
+		// bit set went into a size_t **signed**, and the record ended up
+		// holding 0xFFFFFFFF……, which a lookup never found. On 32 bits there
+		// was no difference, so in the original the fault is not visible.
+		entry(const T& key, const U& value, int next_in_chain, size_t hash_value)
 			: m_next_in_chain(next_in_chain), m_hash_value(hash_value), first(key), second(value)
 		{
 		}
@@ -1219,7 +1223,12 @@ private:
 	{
 		if (m_table == NULL) return -1;
 
-		size_t	hash_value = compute_hash(key);
+		// [openbf2] `add` (line 808) truncates the hash to 32 bits and puts
+		// **the truncated one** into the record. The lookup has to truncate
+		// the same way, otherwise on 64 bits the comparison never matches and
+		// no key is ever found. On the 32 bits tu-testbed was written for,
+		// size_t and unsigned int are the same, so the fault was not visible.
+		size_t	hash_value = (unsigned int) compute_hash(key);
 		int	index = (int) (hash_value & m_table->m_size_mask);
 
 		const entry*	e = &E(index);
