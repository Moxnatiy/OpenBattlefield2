diff --git a/core/src/library.rs b/core/src/library.rs
index 74188cd5..9be3c4c1 100644
--- a/core/src/library.rs
+++ b/core/src/library.rs
@@ -587,6 +587,39 @@ impl<'gc> Library<'gc> {
             return Some(font);
         }
 
+        // [openbf2] Before taking anything else — look for a font from
+        // **the movie itself** under the same name.
+        //
+        // The BF2 menu is played by SwiffPlayer on gameswf, and that pulls
+        // glyphs in this order: first the system font **by name**, and only
+        // then the embedded one (`reference/gameswf`, gameswf_font.cpp:306,
+        // "then use an embedded character"). On a machine with no
+        // `TradeGothic LT BdCondTwenty` installed the embedded one is drawn
+        // — and `mainMenu.swf` carries it with it, 241 glyphs.
+        //
+        // Without this, fields with a system font went to the general
+        // fallback Noto Sans, and the menu looked wide where it should be
+        // narrow. We look **by name**, not by the triple "name + bold +
+        // italic": that is how gameswf asks (`m_fontname`), and under one
+        // name the movie holds both an empty stub (zero glyphs — that is how
+        // Flash marks "the field is drawn with a system font") and the real
+        // font. An exact match found the stub.
+        let wanted = name.to_lowercase();
+        let pick = |fonts: &FontMap<'gc>| {
+            fonts
+                .iter_all()
+                .find(|font| font.descriptor().lowercase_name() == wanted && font.has_glyphs())
+        };
+        if let Some(font) = pick(&self.global_fonts) {
+            return Some(font);
+        }
+        for (_, library) in self.movie_libraries.0.iter() {
+            if let Some(font) = pick(&library.fonts) {
+                tracing::debug!(target: "bf2_bridge", "font {} taken from the movie", name);
+                return Some(font);
+            }
+        }
+
         // Fallback: Try to find an existing font to re-use instead of giving up.
         self.device_fonts.find(&query)
     }
