+++ b/windows/d3d9/src/device/frame_dump.rs
@@ -35,6 +35,65 @@ use crate::{
 /// Dump events name surfaces by texture id so they cross-reference the
 /// per-draw lines, which print the same ids; the raw COM pointer alone
 /// cannot be matched to anything.
+/// Screen-space extent of a draw, from its inline (`*UP`) vertex data.
+///
+/// Reads the first two floats of every vertex — the position slot in every
+/// FVF layout the game uses for 2D — and returns their range. Pre-transformed
+/// (`XYZRHW`) positions are already in pixels, so the result is the on-screen
+/// rectangle; for transformed geometry it is the object-space extent, which
+/// still tells the draws apart.
+pub fn vertex_extent(data: *const c_void, stride: u32, vertices: u32) -> String {
+    if data.is_null() || stride < 8 || vertices == 0 {
+        return String::new();
+    }
+    let base = data.cast::<u8>();
+    let (mut x0, mut y0) = (f32::MAX, f32::MAX);
+    let (mut x1, mut y1) = (f32::MIN, f32::MIN);
+    for i in 0..vertices.min(4096) {
+        // SAFETY: the D3D9 ABI guarantees `vertices * stride` bytes are
+        // readable from `data` for the duration of the call.
+        let at = unsafe { base.add(i as usize * stride as usize) };
+        let x = unsafe { at.cast::<f32>().read_unaligned() };
+        let y = unsafe { at.add(4).cast::<f32>().read_unaligned() };
+        if !x.is_finite() || !y.is_finite() {
+            return String::new();
+        }
+        x0 = x0.min(x);
+        y0 = y0.min(y);
+        x1 = x1.max(x);
+        y1 = y1.max(y);
+    }
+    format!("{x0:.1},{y0:.1} {:.1}x{:.1}", x1 - x0, y1 - y0)
+}
+
+/// Same extent, for a draw that reads a bound vertex buffer.
+///
+/// The game does not use the `*UP` entry points for its interface — every
+/// draw comes from an `IDirect3DVertexBuffer9` — so the stream binding is
+/// where the positions actually live. `backing_ptr` is the CPU-side page the
+/// buffer wraps, `offset` the `SetStreamSource` byte offset.
+pub fn vertex_extent_bound(
+    backing_ptr: u64,
+    backing_len: u64,
+    offset: u32,
+    stride: u32,
+    first_vertex: u32,
+    vertices: u32,
+) -> String {
+    if backing_ptr == 0 || stride < 8 || vertices == 0 {
+        return String::new();
+    }
+    let start = offset as u64 + u64::from(first_vertex) * u64::from(stride);
+    let need = u64::from(vertices) * u64::from(stride);
+    if start.saturating_add(need) > backing_len {
+        return String::new();
+    }
+    // SAFETY: the range was just bounds-checked against the buffer the
+    // device wraps, and the API thread owns it for the duration of the draw.
+    let base = unsafe { (backing_ptr as *const u8).add(start as usize) };
+    vertex_extent(base.cast(), stride, vertices)
+}
