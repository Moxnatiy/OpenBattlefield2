+    // Where the first texture coordinate sits in the interface's own vertex.
+    //
+    // The interface draws with one layout and one only — stride 44, eleven
+    // floats, `x y z  r g b a  u0 v0  u1 v1` — so `u0` is at 7 and `v0` at 8.
+    // That is not read off the FVF, it is read off the dumps: every
+    // two-dimensional call of every frame we have taken carries stride 44, and
+    // the pair at 7 and 8 lands on an entry of `Menu/Atlas/MemeAtlas.tai` to
+    // four decimal places (docs/research/03-frame-dump.md). For any other
+    // stride the coordinate is not printed rather than guessed at.
+    const HUD_STRIDE: u32 = 44;
+    const U0: usize = 7;
+    let texcoord = |index: u32| -> Option<(f32, f32)> {
+        if stride != HUD_STRIDE {
+            return None;
+        }
+        let at = index as usize * stride as usize;
+        // SAFETY: `index` is below `vertices`, checked by the caller, and the
+        // two floats lie inside the vertex.
+        let u = unsafe { base.add(at + U0 * 4).cast::<f32>().read_unaligned() };
+        let v = unsafe { base.add(at + (U0 + 1) * 4).cast::<f32>().read_unaligned() };
+        if u.is_finite() && v.is_finite() { Some((u, v)) } else { None }
+    };
+    // The rectangle a range of vertices cuts out of its texture. For the
+    // interface that rectangle **is** the picture's entry in the atlas index,
+    // so it names the call: a shared bounding box in pixels does not.
+    let uv_rect = |from: u32, count: u32| -> String {
+        let (mut u0, mut v0) = (f32::MAX, f32::MAX);
+        let (mut u1, mut v1) = (f32::MIN, f32::MIN);
+        let mut any = false;
+        for i in from..(from + count) {
+            let Some((u, v)) = texcoord(i) else { return String::new() };
+            u0 = u0.min(u);
+            v0 = v0.min(v);
+            u1 = u1.max(u);
+            v1 = v1.max(v);
+            any = true;
+        }
+        if !any {
+            return String::new();
+        }
+        format!("{u0:.4},{v0:.4},{:.4},{:.4}", u1 - u0, v1 - v0)
+    };
